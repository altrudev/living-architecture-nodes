{
  "schema": "living-architecture-nodes/scanner-conformance/0.1",
  "protocol_version": "0.1.0",
  "purpose": "Language-independent semantic cases for Living Architecture scanner implementations.",
  "required_artifacts": ["ARCH.md", "NERVE.md", "CHANGELOG.node.md"],
  "rules": {
    "companion_pattern": "<dir>/<source-basename>.node.md",
    "node_suffix": ".node.md",
    "root_changelog_is_required_artifact_not_companion_node": true,
    "node_files_are_not_source_files": true
  },
  "cases": [
    {
      "id": "healthy-paired-source",
      "files": ["ARCH.md", "NERVE.md", "CHANGELOG.node.md", "src/app.js", "src/app.node.md"],
      "source_extensions": [".js"],
      "expected": {
        "missing_required": [],
        "source_files": ["src/app.js"],
        "node_files": ["src/app.node.md"],
        "missing_nodes": [],
        "orphan_nodes": []
      }
    },
    {
      "id": "missing-companion",
      "files": ["ARCH.md", "NERVE.md", "CHANGELOG.node.md", "src/app.js"],
      "source_extensions": [".js"],
      "expected": {
        "missing_required": [],
        "source_files": ["src/app.js"],
        "node_files": [],
        "missing_nodes": [{"source_path": "src/app.js", "node_path": "src/app.node.md"}],
        "orphan_nodes": []
      }
    },
    {
      "id": "orphan-companion",
      "files": ["ARCH.md", "NERVE.md", "CHANGELOG.node.md", "src/old.node.md"],
      "source_extensions": [".js"],
      "expected": {
        "missing_required": [],
        "source_files": [],
        "node_files": ["src/old.node.md"],
        "missing_nodes": [],
        "orphan_nodes": ["src/old.node.md"]
      }
    },
    {
      "id": "root-changelog-not-orphan",
      "files": ["ARCH.md", "NERVE.md", "CHANGELOG.node.md"],
      "source_extensions": [".js"],
      "expected": {
        "missing_required": [],
        "source_files": [],
        "node_files": [],
        "missing_nodes": [],
        "orphan_nodes": []
      }
    },
    {
      "id": "required-artifact-loss",
      "files": ["ARCH.md", "src/app.js", "src/app.node.md"],
      "source_extensions": [".js"],
      "expected": {
        "missing_required": ["NERVE.md", "CHANGELOG.node.md"],
        "source_files": ["src/app.js"],
        "node_files": ["src/app.node.md"],
        "missing_nodes": [],
        "orphan_nodes": []
      }
    },
    {
      "id": "node-files-never-become-source",
      "files": ["ARCH.md", "NERVE.md", "CHANGELOG.node.md", "src/widget.node.md"],
      "source_extensions": [".md"],
      "expected": {
        "missing_required": [],
        "source_files": [],
        "node_files": ["src/widget.node.md"],
        "missing_nodes": [],
        "orphan_nodes": ["src/widget.node.md"]
      }
    }
  ]
}
