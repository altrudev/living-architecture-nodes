{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://altru.dev/living-architecture-nodes/schema/adapter-receipt.schema.json",
  "title": "Living Architecture Nodes Adapter Mutation Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "hostKind", "action", "status", "postconditionVerified"],
  "properties": {
    "schema": { "const": "lan.adapter.receipt.v1" },
    "hostKind": { "type": "string", "minLength": 1, "maxLength": 64 },
    "action": { "type": "string", "minLength": 1, "maxLength": 128 },
    "status": { "enum": ["completed", "refused", "failed"] },
    "postconditionVerified": { "type": "boolean" },
    "affectedPaths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "reason": { "type": ["string", "null"] }
  }
}
